 <!-- Delete Account Button -->
<div class="flex items-center justify-between p-4 bg-error/10 border border-error/20 rounded-lg">
  <div>
    <p class="font-medium text-error">Delete Account</p>
    <p class="text-sm text-error/70">Permanently delete your account and all data</p>
  </div>
  <button class="btn btn-error btn-sm btn-outline" onclick="delete_account_modal.showModal()">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
    </svg>
    Delete
  </button>
</div>
<!-- Delete Account Modal -->
<dialog id="delete_account_modal" class="modal">
  <div class="modal-box max-w-md">
    <h3 class="font-bold text-lg text-error mb-4">Delete Account</h3>
    <div class="space-y-4">
      <div class="alert alert-error">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z"></path>
        </svg>
        <div>
          <p class="font-medium">This action cannot be undone!</p>
          <p class="text-sm">All your workout plans and data will be permanently deleted.</p>
        </div>
      </div>
      <%= form_with url: profile_path, method: :delete, local: true, class: "space-y-4" do |form| %>
        <div>
          <label class="label">
            <span class="label-text">Type your email to confirm:</span>
          </label>
          <input 
            type="email" 
            name="confirm_email" 
            placeholder="<%= current_user.email %>" 
            class="input input-bordered w-full" 
            required
          />
        </div>
        <div class="modal-action">
          <button type="button" class="btn btn-outline" onclick="delete_account_modal.close()">Cancel</button>
          <button type="submit" class="btn btn-error">Delete Account</button>
        </div>
      <% end %>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>