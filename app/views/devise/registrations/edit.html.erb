<div class="container mx-auto px-4 py-6 max-w-2xl">
  <!-- Header -->
  <div class="flex items-center gap-4 mb-8">
    <%= link_to :back, class: "btn btn-ghost btn-circle" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    <% end %>
    <div>
      <h1 class="text-3xl font-bold text-base-content">Edit Account</h1>
      <p class="text-base-content/70">Update your account information</p>
    </div>
  </div>
  <!-- Edit Form Card -->
  <div class="card bg-base-100 shadow-lg">
    <div class="card-body">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <!-- Email Section -->
        <div>
          <h2 class="text-xl font-semibold mb-4">Account Information</h2>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <div class="avatar avatar-placeholder">
                <div class="bg-primary text-primary-content rounded-full w-12 h-12">
                  <span class="text-xl font-bold"><%= @user.email.first.upcase %></span>
                </div>
              </div>
              <div>
                <p class="font-medium text-base-content"><%= @user.email %></p>
                <p class="text-sm text-base-content/70">Member since <%= @user.created_at.strftime("%B %Y") %></p>
              </div>
            </div>
          </div>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="alert alert-info mt-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Currently waiting confirmation for: <%= resource.unconfirmed_email %></span>
            </div>
          <% end %>
        </div>
        <div class="divider"></div>
        <!-- Password Section -->
        <div>
          <h2 class="text-xl font-semibold mb-4">Change Password</h2>
          <p class="text-sm text-base-content/70 mb-4">Leave password fields blank if you don't want to change your password</p>
          <div class="space-y-4">
            <!-- Current Password -->
            <div class="form-control">
              <%= f.label :current_password, class: "label" do %>
                <span class="label-text font-medium">Current Password</span>
              <% end %>
              <%= f.password_field :current_password, 
                  autocomplete: "current-password",
                  class: "input input-bordered w-full",
                  placeholder: "Enter your current password" %>
              <label class="label">
                <span class="label-text-alt">We need your current password to confirm your changes</span>
              </label>
            </div>
            <!-- New Password -->
            <div class="form-control">
              <%= f.label :password, class: "label" do %>
                <span class="label-text font-medium">New Password</span>
              <% end %>
              <%= f.password_field :password, 
                  autocomplete: "new-password",
                  class: "input input-bordered w-full",
                  placeholder: "Enter new password" %>
              <% if @minimum_password_length %>
                <label class="label">
                  <span class="label-text-alt"><%= @minimum_password_length %> characters minimum</span>
                </label>
              <% end %>
            </div>
            <!-- Confirm New Password -->
            <div class="form-control">
              <%= f.label :password_confirmation, class: "label" do %>
                <span class="label-text font-medium">Confirm New Password</span>
              <% end %>
              <%= f.password_field :password_confirmation, 
                  autocomplete: "new-password",
                  class: "input input-bordered w-full",
                  placeholder: "Confirm your new password" %>
            </div>
          </div>
        </div>
        <!-- Form Actions -->
        <div class="card-actions justify-end pt-6">
          <%= link_to :back, class: "btn btn-outline" do %>
            Cancel
          <% end %>
          <%= f.submit "Update Account", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Danger Zone -->
  <div class="card bg-base-100 shadow-lg mt-6">
    <div class="card-body">
      <h3 class="text-xl font-semibold text-error mb-4">Danger Zone</h3>
      <%= render 'profiles/delete_account' %>
    </div>
  </div>
</div>
