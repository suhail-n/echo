<%
  # Nil or empty message?
  return if !defined?(message) || message.blank?

  # Determine the alert class based on the type
  alert_class = case type.to_s
                when 'notice', 'success'
                  'alert-success'
                when 'alert', 'error'
                  'alert-error'
                when 'warning'
                  'alert-warning'
                else
                  'alert-info'
                end
%>
<div class="alert <%= alert_class %> shadow-lg">
  <div>
    <span><%= message %></span>
  </div>
</div>
